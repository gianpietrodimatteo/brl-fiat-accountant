{
  "name": "brl-fiat-accountant-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright end-to-end suite for the BRL/fiat accountant application, run in Simulated Mode",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "npm ci --prefix ../backend && npm ci --prefix ../frontend",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0"
  }
}
